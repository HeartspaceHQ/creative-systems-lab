{
  "$comment": "Aster Lane design source. Invented example brand. Colours are named by value here and given roles per layer below; templates only ever read roles.",
  "colour": {
    "ink": "#1f2a44",
    "paper": "#f4efe6",
    "clay": "#c4623f",
    "moss": "#5f7a4f",
    "sand": "#e2c08d",
    "moss-deep": "#4f6841",
    "rust": "#9c4b2c"
  },
  "layers": {
    "day": {
      "ground": "paper",
      "text": "ink",
      "quiet": "moss-deep",
      "accent": "clay",
      "line": "ink",
      "light": "sand",
      "glow": "clay",
      "warmth": "rust"
    },
    "night": {
      "ground": "ink",
      "text": "paper",
      "quiet": "sand",
      "accent": "sand",
      "line": "paper",
      "light": "sand",
      "glow": "clay",
      "warmth": "rust"
    },
    "clay": {
      "ground": "rust",
      "text": "paper",
      "quiet": "paper",
      "accent": "sand",
      "line": "paper",
      "light": "sand",
      "glow": "clay",
      "warmth": "rust"
    }
  },
  "type": {
    "display": {
      "family": "Playfair Display",
      "weight": 560,
      "tracking": -0.015,
      "leading": 0.98
    },
    "body": {
      "family": "DM Sans",
      "weight": 400,
      "tracking": 0,
      "leading": 1.32
    },
    "label": {
      "family": "DM Sans",
      "weight": 600,
      "tracking": 0.14,
      "leading": 1.2
    }
  },
  "rules": {
    "$comment": "Checked before anything is rendered.",
    "min_contrast_body": 4.5,
    "min_contrast_large": 3.0,
    "accent_is_text": false,
    "display_to_body_min_ratio": 4.0,
    "min_body_px": 16,
    "safe_margin_u": 6
  },
  "motion": {
    "length_s": 6,
    "fps": 30,
    "ring_ripple_s": 2.4,
    "steep_arc_s": 4.0
  },
  "$comment_tones": "moss-deep and rust were added after the first source check failed: moss on paper was 4.18:1 and paper on clay 3.55:1. The brand colours are unchanged; these are darker working tones for text-bearing grounds."
}
